<h1>Hi, <%= current_user.name %> 👋</h1>

<div class="grid grid-3">
  <div class="card stat">
    <div class="stat-label">Current score</div>
    <div class="stat-value"><%= current_user.latest_score || "—" %></div>
    <% if @score_goal %>
      <div class="stat-sub">
        Goal: <%= @score_goal.target_score %> by <%= @score_goal.target_date.strftime("%b %Y") %>
        (<%= link_to "edit", edit_score_goal_path %>)
      </div>
      <% if (remaining = @score_goal.points_remaining) %>
        <% pct = [((@score_goal.target_score - remaining - 300) * 100.0 / (@score_goal.target_score - 300)), 100].min %>
        <div class="progress"><div class="progress-fill" style="width: <%= pct.round %>%"></div></div>
      <% end %>
    <% else %>
      <div class="stat-sub"><%= link_to "Set a score goal →", new_score_goal_path %></div>
    <% end %>
  </div>

  <div class="card stat">
    <div class="stat-label">On-time payment rate</div>
    <div class="stat-value">
      <%= current_user.on_time_rate ? "#{(current_user.on_time_rate * 100).round}%" : "—" %>
    </div>
    <div class="stat-sub">Across <%= pluralize(current_user.payments.settled.count, "settled payment") %></div>
  </div>

  <div class="card stat">
    <div class="stat-label">Open disputes</div>
    <div class="stat-value"><%= @open_disputes.count %></div>
    <div class="stat-sub"><%= link_to "Start a dispute →", new_dispute_path %></div>
  </div>
</div>

<section class="card">
  <h2>🤖 Coach tips</h2>
  <ul class="tips">
    <% @tips.each do |tip| %>
      <li class="tip tip-<%= tip.severity %>"><%= tip.message %></li>
    <% end %>
  </ul>
</section>

<div class="grid grid-2">
  <section class="card">
    <h2>Score trend</h2>
    <% if @score_entries.any? %>
      <table>
        <thead><tr><th>Date</th><th>Score</th><th></th></tr></thead>
        <tbody>
          <% @score_entries.each do |entry| %>
            <tr>
              <td><%= entry.recorded_on.strftime("%b %-d, %Y") %></td>
              <td><strong><%= entry.score %></strong></td>
              <td><%= button_to "×", score_entry_path(entry), method: :delete, class: "btn-mini" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">No check-ins yet.</p>
    <% end %>

    <%= form_with model: ScoreEntry.new, url: score_entries_path, class: "inline-form" do |f| %>
      <%= f.number_field :score, placeholder: "Score (300–850)", min: 300, max: 850, required: true %>
      <%= f.date_field :recorded_on, value: Date.current, required: true %>
      <%= f.submit "Log check-in", class: "btn" %>
    <% end %>
  </section>

  <section class="card">
    <h2>Accounts</h2>
    <% if @accounts.any? %>
      <table>
        <thead><tr><th>Account</th><th>Utilization</th><th>Status</th></tr></thead>
        <tbody>
          <% @accounts.each do |account| %>
            <tr>
              <td><%= link_to account.name, account %></td>
              <td><%= account.utilization_pct %>%</td>
              <td><%= status_badge(account.status) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="muted">No accounts yet. <%= link_to "Open one →", new_credit_account_path %></p>
    <% end %>
  </section>
</div>
